%% Generated by ohmyjob (scripts/resume_build.py) from one resume yaml. Do not edit: edit the yaml.
%% Jinja delimiters here are angle-bracket pairs (percent, double angle, hash), never braces. Every text value goes through the tex filter.
\documentclass[11pt,<< paper_option >>]{awesome-cv}

%% The class loads its fonts with the HarfBuzz renderer, which writes a hyphen as U+00AD (soft hyphen) in the PDF text
%% layer and breaks keyword matching. The same fonts, declared again with the Node renderer, keep a plain hyphen.
\setmainfont{Source Sans 3}[Renderer=Node, UprightFont=*, ItalicFont=* Italic, BoldFont=* Bold,
  BoldItalicFont=* Bold Italic, FontFace={l}{n}{Font=* Light}, FontFace={l}{it}{Font=* Light Italic}]
\setsansfont{Source Sans 3}[Renderer=Node, UprightFont=*, ItalicFont=* Italic, BoldFont=* Bold,
  BoldItalicFont=* Bold Italic, FontFace={l}{n}{Font=* Light}, FontFace={l}{it}{Font=* Light Italic}]
\renewfontfamily\roboto{Roboto}[Renderer=Node, UprightFont=*, ItalicFont=* Italic, BoldFont=* Bold,
  BoldItalicFont=* Bold Italic, FontFace={l}{n}{Font=* Light}, FontFace={l}{it}{Font=* Light Italic}]
%% A character the font lacks is an error (reported as the build's FAIL reason), never silently dropped text.
\tracinglostchars=3

%% Compact layout. The class file itself is never edited; every change is made here.
\geometry{<< paper_option >>, left=1.5cm, top=1.1cm, right=1.5cm, bottom=1.1cm, footskip=0.4cm}
\pagestyle{empty}
<% if accent_hex %>
\definecolor{acvaccent}{HTML}{<< accent_hex >>}
\colorlet{awesome}{acvaccent}
<% else %>
\colorlet{awesome}{<< accent_name >>}
<% endif %>
\renewcommand{\acvSectionTopSkip}{1.5mm}
\renewcommand{\acvHeaderAfterSocialSkip}{2mm}
\renewcommand{\acvHeaderAfterPositionSkip}{0mm}

<% if photo %>
\photo[circle,edge,left]{<< photo >>}
<% endif %>
\name{<< name.first|plain >>}{<< name.last|plain >>}
\position{<< title|plain >>}
<% if address %>\address{<< address|plain >>}<% endif %>

<% if phone %>\mobile{<< phone|plain >>}<% endif %>

<% if email %>\email{<< email|plain >>}<% endif %>

<% if date_of_birth %>\dateofbirth{<< date_of_birth|plain >>}<% endif %>

<% if homepage %>\homepage{<< homepage >>}<% endif %>

<% if github %>\github{<< github|plain >>}<% endif %>

<% if linkedin %>\linkedin{<< linkedin|plain >>}<% endif %>

<% if extra %>\extrainfo{<< extra|plain >>}<% endif %>


\begin{document}
\makecvheader[C]

<% if introduction %>
\cvsection{<< headings.summary|plain >>}
\par
\begin{cvparagraph}
<< introduction|tex >>
\end{cvparagraph}
<% endif %>

<% if experience %>
\cvsection{<< headings.experience|plain >>}
\begin{cventries}
<% for e in experience %>
  \cventry{<< e.position|plain >>}{<< e.title|plain >>}{<< e.location|plain >>}{<< e.dates|plain >>}{<< e.bullets|cvitems >>}
<% endfor %>
\end{cventries}
<% endif %>

<% if projects %>
\cvsection{<< headings.projects|plain >>}
\begin{cventries}
<% for p in projects %>
  \cventry{<< p.title|plain >>}{}{}{<< p.repo >>}{<< p.bullets|cvitems >>}
<% endfor %>
\end{cventries}
<% endif %>

<% if education %>
\cvsection{<< headings.education|plain >>}
\begin{cventries}
<% for d in education %>
  \cventry{<< d.degree|plain >>}{<< d.school|plain >>}{<< d.location|plain >>}{<< d.dates|plain >>}{<< d.details|cvitems >>}
<% endfor %>
\end{cventries}
<% endif %>

<% if skills %>
\cvsection{<< headings.skills|plain >>}
\begin{cvskills}
<% for s in skills %>
  \cvskill{<< s.label|plain >>}{<< s.set|tex >>}
<% endfor %>
\end{cvskills}
<% endif %>

<% if interests %>
\cvsection{<< headings.interests|plain >>}
\par
\begin{cvparagraph}
<< interests|tex >>
\end{cvparagraph}
<% endif %>

\end{document}
