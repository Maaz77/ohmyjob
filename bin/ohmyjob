#!/usr/bin/env bash
# ohmyjob <prep|apply|scrape|reconcile|resume|dream> <args>: runs scripts/<pj|aa|scrape|reconcile|resume_build|dream>.py with the
# plugin's Python, inside the workspace. While the plugin is enabled, Claude Code puts this folder on the PATH of the
# Bash tool (also for subagents), but does not export CLAUDE_PLUGIN_ROOT or CLAUDE_PLUGIN_DATA there. So setup writes
# <workspace>/.ohmyjob/env.sh (OHMYJOB_PY, OHMYJOB_UV, OHMYJOB_DATA, OHMYJOB_LUALATEX, absolute paths), read here.
# Output on stdout is for the agents: every error is one line that starts with "ohmyjob:", with exit code 3.
set -euo pipefail

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRIPTS="$PLUGIN_ROOT/scripts"

fatal() { echo "ohmyjob: $*"; exit 3; }

case "${1:-}" in
  prep) script="pj.py" ;;
  apply) script="aa.py" ;;
  scrape) script="scrape.py" ;;
  reconcile) script="reconcile.py" ;;
  resume) script="resume_build.py" ;;
  dream) script="dream.py" ;;
  add-job) script="add_job.py" ;;
  *) echo "usage: ohmyjob <prep|apply|scrape|reconcile|resume|dream> <args>"; exit 2 ;;
esac

# The workspace: $OHMYJOB_WORKSPACE, else the one discovery rule (workspace.find_workspace) from the current folder (the
# Bash tool's cwd; it has no CLAUDE_PROJECT_DIR): walk up, and at each folder D it is D when D/ohmyjob.json exists, else
# D/ohmyjob when D/ohmyjob/ohmyjob.json exists. So the project folder and any folder inside ohmyjob/ both work.
root="${OHMYJOB_WORKSPACE:-}"
if [ -z "$root" ]; then
  dir="$PWD"
  while [ -n "$dir" ]; do
    case "$dir" in /*) ;; *) break ;; esac
    if [ -f "$dir/ohmyjob.json" ]; then root="$dir"; break; fi
    if [ -f "${dir%/}/ohmyjob/ohmyjob.json" ]; then root="${dir%/}/ohmyjob"; break; fi
    case "$dir" in /) dir="" ;; /*/*) dir="${dir%/*}" ;; *) dir="/" ;; esac
  done
fi
[ -n "$root" ] && [ -f "$root/ohmyjob.json" ] || fatal "no ohmyjob.json in $PWD or above, nor in an ohmyjob/ folder there. Start Claude in your project folder and run /ohmyjob:setup."

# Paths from setup. A caller that already set OHMYJOB_PY (tests) needs no env.sh. The file is parsed, never sourced:
# it sits in a folder the agents can write, and Bash(ohmyjob *) is pre-allowed. Accepted: blank lines, # comments and
# NAME='value' (or NAME=value) for the four names. A quoted value is taken literally and holds no single quote; an
# unquoted one holds no quote, $, backtick, backslash or whitespace. Anything else is an error.
env_file="$root/.ohmyjob/env.sh"
py_from_file=0
if [ -f "$env_file" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ""|"#"*) continue ;; esac
    name="${line%%=*}"
    value="${line#*=}"
    [ "$name" != "$line" ] || fatal "$env_file has a line that is not NAME='value', run /ohmyjob:setup"
    case "$value" in
      "'"*"'") value="${value#\'}"; value="${value%\'}"
               case "$value" in *\'*) fatal "$env_file has a value that is not plain text, run /ohmyjob:setup" ;; esac ;;
      *[\'\"\$\`\\[:space:]]*) fatal "$env_file has a value that is not plain text, run /ohmyjob:setup" ;;
    esac
    case "$name" in
      OHMYJOB_PY) OHMYJOB_PY="$value"; py_from_file=1 ;;
      OHMYJOB_UV) OHMYJOB_UV="$value" ;;
      OHMYJOB_DATA) OHMYJOB_DATA="$value" ;;
      OHMYJOB_LUALATEX) OHMYJOB_LUALATEX="$value" ;;
      *) fatal "$env_file sets $name, which is not one of the four known names, run /ohmyjob:setup" ;;
    esac
  done < "$env_file"
  # Parsing is not enough: env.sh must not name a program that the allowed `ohmyjob *` could be turned into a shell with
  # (OHMYJOB_PY=/usr/bin/find). The interpreter is exactly the plugin's venv; uv and lualatex keep their names.
  if [ "$py_from_file" = 1 ] && [ "${OHMYJOB_PY:-}" != "${OHMYJOB_DATA:-}/venv/bin/python" ]; then
    fatal "environment missing or stale, run /ohmyjob:setup"
  fi
  [ -z "${OHMYJOB_UV:-}" ] || [ "${OHMYJOB_UV##*/}" = "uv" ] || fatal "$env_file has an OHMYJOB_UV that is not uv, run /ohmyjob:setup"
  [ -z "${OHMYJOB_LUALATEX:-}" ] || [ "${OHMYJOB_LUALATEX##*/}" = "lualatex" ] || fatal "$env_file has an OHMYJOB_LUALATEX that is not lualatex, run /ohmyjob:setup"
fi
[ -n "${OHMYJOB_PY:-}" ] && [ -x "$OHMYJOB_PY" ] || fatal "environment missing or stale, run /ohmyjob:setup"
[ -f "$SCRIPTS/$script" ] || fatal "$SCRIPTS/$script is missing from the plugin, reinstall it"

# Dependencies follow the plugin's uv.lock, re-synced only at the start of a run (one process): never inside the
# parallel workers, which would race. The stamp is the lock's checksum from the last sync (setup writes it too).
sha256_of() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }
resync() {
  local lock="$PLUGIN_ROOT/uv.lock" stamp="${OHMYJOB_DATA:-}/venv/uv.lock.sha256" want uv
  [ -n "${OHMYJOB_DATA:-}" ] && [ -f "$lock" ] || return 0
  want="$(sha256_of "$lock")"
  [ "$want" = "$(cat "$stamp" 2>/dev/null || true)" ] && return 0
  uv="${OHMYJOB_UV:-$(command -v uv || true)}"
  [ -n "$uv" ] && [ -x "$uv" ] || fatal "uv.lock changed but uv was not found, run /ohmyjob:setup"
  UV_PROJECT_ENVIRONMENT="$OHMYJOB_DATA/venv" UV_PYTHON_INSTALL_DIR="$OHMYJOB_DATA/python" UV_CACHE_DIR="$OHMYJOB_DATA/uv-cache" "$uv" sync --frozen --no-dev --quiet --project "$PLUGIN_ROOT" >&2 \
    || fatal "uv sync failed, run /ohmyjob:setup"
  echo "$want" > "$stamp"
}
if [ "${2:-}" = "start" ] && { [ "$script" = "pj.py" ] || [ "$script" = "aa.py" ]; }; then
  resync
fi

export OHMYJOB_WORKSPACE="$root"
export OHMYJOB_PY OHMYJOB_UV OHMYJOB_DATA OHMYJOB_LUALATEX
shift
exec "$OHMYJOB_PY" "$SCRIPTS/$script" "$@"
